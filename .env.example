# Copy to .env and adjust. Never commit .env.

# Hostnames "db" and "redis" are the Docker Compose service names.
# If you run the API outside Docker, use localhost instead.
DATABASE_URL=postgresql+asyncpg://crowdsurf:crowdsurf@db:5432/crowdsurf
REDIS_URL=redis://redis:6379/0

# Used to sign host and guest tokens. Use a long random string outside local dev.
JWT_SECRET=change-me

ROOM_TTL_HOURS=12
VOTE_RATE_LIMIT=10
SEARCH_CACHE_TTL=3600

# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
